# Copy this file to .env and fill in your values

# PostgreSQL connection string (same for local dev and production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# OpenAI API Key (required for the chat feature)
OPENAI_API_KEY="sk-..."

# Required to connect a personal Rohlik account via MCP OAuth.
# Use the public origin of this app, without a trailing slash (http://localhost:3000 locally).
APP_BASE_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ROHLIK_TOKEN_ENCRYPTION_KEY=""
