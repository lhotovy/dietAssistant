# Copy this file to .env and fill in your values

# PostgreSQL connection string (same for local dev and production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# OpenAI API Key (required for the chat feature)
OPENAI_API_KEY="sk-..."

# Required for OAuth only. Legacy MCP login does not use a callback.
# Use the public origin of this app, without a trailing slash (http://localhost:3000 locally).
APP_BASE_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required for either OAuth or legacy login; encrypts tokens or login credentials.
ROHLIK_TOKEN_ENCRYPTION_KEY=""
# Optional: client registered/approved by Rohlik for APP_BASE_URL.
# When set, the app skips dynamic client registration.
ROHLIK_OAUTH_CLIENT_ID=""
# Set only if Rohlik issued a confidential client secret.
ROHLIK_OAUTH_CLIENT_SECRET=""
